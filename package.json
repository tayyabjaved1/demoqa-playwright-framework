{
  "name": "demoqa-playwright-framework",
  "version": "1.4.0",
  "private": true,
  "description": "Reusable Playwright + TypeScript automation framework demonstrated against DemoQA",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --grep @api",
    "test:ui": "playwright test --grep @ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps",
    "docs:check": "node scripts/check-docs-changes.mjs"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  }
}
